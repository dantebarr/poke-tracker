{
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx --no-install supabase stop 2>/dev/null || true",
            "timeout": 120,
            "statusMessage": "Stopping local Supabase…"
          }
        ]
      }
    ]
  }
}

# Copy to .env.local and fill in. Nothing here is committed.

# --- Supabase -----------------------------------------------------------------
# For local development these come from `npx supabase status`. For the deployed
# app they come from the Supabase project's API settings.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Access -------------------------------------------------------------------
# Comma-separated Google account addresses permitted to sign in. Checked at
# /auth/callback; an account that fails it gets no trainer record and no data.
# Unset or empty admits nobody — the allow-list fails closed.
POKE_TRACKER_ALLOWED_EMAILS=

# --- Google OAuth -------------------------------------------------------------
# Read by the Supabase CLI when starting the local stack (see supabase/config.toml).
# Create the credentials in the Google Cloud console with
# <supabase-url>/auth/v1/callback as the authorised redirect URI.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Tests only ---------------------------------------------------------------
# The local stack's service-role key, used by the integration tests to create and
# tear down test accounts. Never used by the app itself.
SUPABASE_SERVICE_ROLE_KEY=
